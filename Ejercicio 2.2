public class Main {

    public static void main(String[] args) {

        Mascota mascota1 = new Mascota("Cucú", "Perro", 10);
        Mascota mascota2 = new Mascota("Monshi", "Gato", 2);
        Mascota mascota3 = new Mascota("Bunny", "Conejo", 5);

        System.out.println("Mascota 1: " + mascota1.nombre + ", especie: " + mascota1.especie + ", edad: " + mascota1.edad + " años.");
        System.out.println("Mascota 2: " + mascota2.nombre + ", especie: " + mascota2.especie + ", edad: " + mascota2.edad + " años.");
        System.out.println("Mascota 3: " + mascota3.nombre + ", especie: " + mascota3.especie + ", edad: " + mascota3.edad + " años.");
    }
}

class Mascota {

    String nombre;
    String especie;
    int edad;

    public Mascota(String nombre, String especie, int edad) {
        this.nombre = nombre;
        this.especie = especie;
        this.edad = edad;
    }
}
